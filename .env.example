# MLX LLM backend (in-process, Apple Silicon)
# HuggingFace repo ID — downloaded and cached on first run via setup.sh
MODEL=mlx-community/gemma-3-1b-it-4bit

# To use a larger model:
# MODEL=mlx-community/gemma-3-4b-it-4bit

# Optional: path to LoRA adapter weights from fine-tuning
# MLX_ADAPTER_PATH=adapters/
